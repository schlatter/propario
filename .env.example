# Copy to .env next to compose.yaml. Never commit .env.
# Public address; passkeys are bound to it.
ORIGIN=https://propario.example.org
# 32 random bytes, created once (openssl rand -base64 32); keep a copy, a new key cannot open old data
DATA_KEY=
# Behind a trusted reverse proxy:
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
