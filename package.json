{
  "name": "propario",
  "version": "0.23.0",
  "description": "Compare faster, decide better – a self-hostable web app.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && npm run build:demo && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run test:e2e",
    "backup": "node --disable-warning=ExperimentalWarning server/backup.ts",
    "recovery-key": "node --disable-warning=ExperimentalWarning server/recovery-key.ts",
    "deps": "npm outdated; npm audit",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json",
    "screenshots": "vite build && SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "build:demo": "VITE_DEMO_ONLY=1 vite build --base=/propario/demo/ --outDir dist-demo --emptyOutDir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@simplewebauthn/server": "14.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@playwright/test": "1.65.1",
    "@simplewebauthn/browser": "14.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "prettier": "3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "three": "0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "playwright-core": "1.65.0"
  }
}
